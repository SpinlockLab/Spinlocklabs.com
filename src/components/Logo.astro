---
interface Props {
  class?: string;
  wordmark?: boolean;
}

const { class: className, wordmark = true } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5 text-ink", className]}>
  <svg viewBox="0 0 64 64" class="h-7 w-7 shrink-0" aria-hidden="true">
    <path
      d="M21 29v-7a11 11 0 0 1 22 0v7"
      fill="none"
      stroke="currentColor"
      stroke-width="6"
      stroke-linecap="round"
    />
    <rect x="12" y="28" width="40" height="28" rx="7" fill="#2148FF" />
    <path
      d="M25 35h14L25 49h14"
      fill="none"
      stroke="#FFFFFF"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  {
    wordmark ? (
      <span class="font-serif text-xl font-medium tracking-tight">
        Spinlock<span class="text-accent">Labs</span>
      </span>
    ) : (
      <span class="sr-only">SpinlockLabs</span>
    )
  }
</span>
