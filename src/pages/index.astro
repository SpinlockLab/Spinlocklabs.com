---
import AppLayout from "@layouts/AppLayout.astro";
import ProjectList from "@components/ProjectList.astro";
import { getCollection } from "astro:content";
import { email } from "@data/site";

const projects = (await getCollection("research")).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf(),
);
---

<AppLayout>
  <section class="mx-auto max-w-5xl px-6 pb-20 pt-20 sm:pt-28">
    <p class="mb-6 text-sm font-medium text-ink-500">
      Research lab under
      <a
        href="https://ztasecurity.com"
        target="_blank"
        rel="noopener noreferrer"
        class="underline decoration-line-strong underline-offset-2 hover:text-ink"
        >ZTASecurity</a
      >
    </p>
    <h1
      class="max-w-3xl font-serif text-4xl font-medium leading-[1.1] tracking-tight sm:text-6xl"
    >
      Measuring what local AI can do in security.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-700">
      SpinlockLabs studies local large language models for security tasks. We
      run models on our own hardware, with fixed probes and published numbers.
      No marketing claims.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href="/research/"
        class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-ink-700"
      >
        Current research
      </a>
      <a
        href="/blog/"
        class="rounded-full border border-line-strong px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-paper-200"
      >
        Blog
      </a>
      <a
        href={`mailto:${email}`}
        class="rounded-full border border-line-strong px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-paper-200"
      >
        Contact
      </a>
    </div>
  </section>

  <section id="approach" class="border-t border-line">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid gap-12 lg:grid-cols-3">
        <div>
          <h2 class="font-serif text-3xl font-medium tracking-tight">
            How we work
          </h2>
          <p class="mt-4 leading-relaxed text-ink-500">
            A project page states the question, the setup, and what has been
            measured. Findings land in the blog once numbers are stable.
          </p>
        </div>
        <ul class="grid gap-px overflow-hidden rounded-xl border border-line bg-line lg:col-span-2">
          <li class="bg-paper-50 p-6 sm:p-8">
            <h3 class="font-medium">Local by design</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">
              Models run on our own GPUs. No prompts or data leave the lab. The
              inference engine is open source.
            </p>
          </li>
          <li class="bg-paper-50 p-6 sm:p-8">
            <h3 class="font-medium">Fixed probes</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">
              Every task has a defined rubric. The same probe set runs across
              model versions and quantizations, so results are comparable.
            </p>
          </li>
          <li class="bg-paper-50 p-6 sm:p-8">
            <h3 class="font-medium">Failures included</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">
              We report how models fail, not only what they get right.
              Hallucinated CVEs and wrong patches are data.
            </p>
          </li>
          <li class="bg-paper-50 p-6 sm:p-8">
            <h3 class="font-medium">Hardware named</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">
              Results carry the machine they came from: two Radeon AI PRO
              R9700 GPUs today, with the engine and model versions listed.
            </p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section id="research" class="border-t border-line">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="mb-8 flex items-baseline justify-between gap-4">
        <h2 class="font-serif text-3xl font-medium tracking-tight">
          Research projects
        </h2>
        <a
          href="/research/"
          class="text-sm text-ink-500 transition-colors hover:text-ink"
        >
          All projects &rarr;
        </a>
      </div>
      <ProjectList projects={projects} />
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6">
    <div
      class="flex flex-col items-start justify-between gap-6 rounded-2xl bg-paper-200 px-8 py-12 sm:flex-row sm:items-center sm:px-12"
    >
      <div>
        <h2 class="font-serif text-2xl font-medium tracking-tight sm:text-3xl">
          Questions about the lab?
        </h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-500">
          We answer on
          <a
            href={`mailto:${email}`}
            class="underline decoration-line-strong underline-offset-2"
            >{email}</a
          >.
          For ZTASecurity services, see the parent organization.
        </p>
      </div>
      <a
        href={`mailto:${email}`}
        class="shrink-0 rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-ink-700"
      >
        Write to us
      </a>
    </div>
  </section>
</AppLayout>
