---
import ResearchLayout from "@layouts/ResearchLayout.astro";
import { CollectionEntry, getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("research");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"research">;
}
const { project } = Astro.props;
const { Content } = await render(project);
---

<ResearchLayout project={project} content={Content} />
